[playerbot]
#
# Experimental port. Defaults refuse every new bot.
# Enable and KillSwitch must both be changed, and a faction cap must be above 0,
# before the policy allows a creation. This build still does not place bots on a map.
#

# Master switch. 0 = the module creates nothing.
Playerbot.Enable = 0

# Second stop. 1 = refuse new bots even if Enable is 1.
Playerbot.Population.KillSwitch = 1

# Maximum new bots online for that faction. 0 = none.
Playerbot.Population.Alliance = 0
Playerbot.Population.Horde = 0

# Existing player-security auth account ids. 0 refuses creation.
# AllianceIds and HordeIds are optional comma-separated extras so one faction
# can use several accounts. This build does not create auth accounts.
# An id listed for both factions is ignored. A GM account is refused.
# Login requires a factory marker on one of these accounts. Level may be above 1.
Playerbot.Account.Alliance = 0
Playerbot.Account.Horde = 0
Playerbot.Account.AllianceIds =
Playerbot.Account.HordeIds =

# One action per world tick, 5ms budget. A bad path does not move the bot.
# Starter areas are used when a tile is actually present. Do not raise population here.

# Attack an opposite-faction player only when this is 1. Default refuses every player.
Playerbot.PvP = 0

# 1 logs a decision about every 400ms. Identical lines are sampled (first, then every 8th).
# The scan line includes grid, raw, kept, and refused counts from a phase-ignoring grid scan.
# Each refused candidate also logs name, entry, level, faction template, unit flags, npc flags,
# alive, reaction, hostile, friendly, distance, the refuse reason, and whether that template is friendly.
# Quest-giver candidates log the same fields and CanTakeQuest per offered quest.
# Held objectives are sought to 120 yards, prey to 80, and idle wandering stays inside a 150-yard bind leash.
# Also add to worldserver.conf: Logger.playerbot=3,Console Server
Playerbot.Debug = 0

# Persisted characters and marker rows per pool account, not the online cap.
# Online count is Playerbot.Population.*. 25 online needs that cap plus enough
# account ids that MaxCharacters times the account count can hold them.
Playerbot.Account.MaxCharacters = 10
